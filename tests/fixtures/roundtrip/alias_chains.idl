// Typedefs reached from another module: the element of a sequence, array,
// map or optional member, alias chains crossing modules, inside unions
// and key members, under every extensibility. A backend that unrolls an
// alias must name each type as seen from the module it writes into.

module A {
    struct P { long v; };
    enum Kind { K_ONE, K_TWO };
    typedef sequence<P> PList;
    typedef P PArr[2];
    typedef map<long, P> PMap;
    typedef string<16> Name;
    typedef Kind KindAlias;
    module Inner {
        struct Q { @key long id; A::Name label; };
        typedef sequence<Q, 4> QList;
    };
};

module C {
    // An alias of an alias from another module.
    typedef A::PList PList2;
    typedef A::Inner::QList QList2;
    typedef A::KindAlias KindAlias2;
};

module B {
    @mutable struct M {
        A::PList items;
        A::PArr pair;
        A::PMap by_id;
        @optional A::PList maybe;
        C::PList2 chained;
        C::QList2 qs;
        A::Kind kind;
        C::KindAlias2 kind2;
    };
    @final struct F {
        A::PList items;
        A::PArr pair;
        C::QList2 qs;
        A::Name name;
    };
    @appendable struct K {
        @key A::Inner::Q q;
        @key A::Name name;
        @key C::KindAlias2 kind;
        A::PList items;
    };
    union U switch (C::KindAlias2) {
        case A::K_ONE: A::PList items;
        case A::K_TWO: C::QList2 qs;
    };
    @mutable union MU switch (long) {
        case 1: A::PArr pair;
        case 2: C::PList2 chained;
    };
    struct HoldsUnions { @key long id; U u; MU mu; };
};
